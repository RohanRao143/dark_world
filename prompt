import 'dart:math';

import 'package:flame/components.dart';
import 'package:flutter/material.dart';
import 'my_game.dart';

class Background extends Component with HasGameReference<MyGame> {
  bool isMoving = false;
  final Random _rand = Random();

  final List<_Building> farBuildings = [];
  final List<_Building> midBuildings = [];
  final List<_Building> nearBuildings = [];

  @override
  Future<void> onLoad() async {
    _generateBuildings(farBuildings, 60, 120, Colors.grey.shade700, 0.3);
    _generateBuildings(midBuildings, 100, 160, Colors.grey.shade800, 0.6);
    _generateBuildings(nearBuildings, 140, 200, Colors.grey.shade900, 1.0);
    _generateMountains();
    _generateStars();
  }

  List<Offset> _generateWindows(double buildingWidth, double buildingHeight) {
    final List<Offset> windows = [];
    final rand = Random();

    // Fewer windows per building, 2–5
    int windowCount = 2 + rand.nextInt(4);

    for (int i = 0; i < windowCount; i++) {
      // random position inside the building
      double x = rand.nextDouble() * (buildingWidth - 6); // slightly bigger width
      double y = rand.nextDouble() * (buildingHeight - 12); // slightly bigger height

      windows.add(Offset(x, y));
    }

    return windows;
  }

  final List<_Star> stars = [];

  void _generateStars() {
    final rand = Random();

    final screenWidth = game.size.x;
    final screenHeight = game.size.y;

    for (int i = 0; i < 20; i++) {
      stars.add(_Star(
        Offset(
          rand.nextDouble() * screenWidth,           // full width
          rand.nextDouble() * (screenHeight * 0.75), // top 75% for sky
        ),
        rand.nextDouble() < 0.7 ? 1.0 : 2.5,       // small + few big
        rand.nextDouble() * 0.8 + 0.2,             // glow intensity
      ));
    }
  }

  void _generateBuildings(
    List<_Building> list,
    double minHeight,
    double maxHeight,
    Color color,
    double speed,
  ) {
    double x = 0;

    while (x < game.size.x * 2) {
      final width = 60 + _rand.nextDouble() * 60; // 60–120
      final height = minHeight + _rand.nextDouble() * (maxHeight - minHeight);

      final windows = _generateWindows(width, height); // <-- new windows per building
      final litWindows = List<bool>.generate(
        windows.length,
        (i) => _rand.nextBool(),
      );

      // list.add(_Building(
      //   x: x,
      //   width: width,
      //   height: height,
      //   color: color,
      //   speed: speed,
      //   windows: windows,
      //   litWindows: litWindows,
      // ));

      list.add(_Building(
        x: x,
        width: width,
        height: height,
        color: color,
        speed: speed,
        windows: windows,
        litWindows: litWindows,
      ));

      x += width + 160; // spacing depends on width
    }
  }
  
  final List<_Mountain> mountains = [];

  void _generateMountains() {
    mountains.clear();
    double x = 0;
    final rand = Random();

    while (x < game.size.x * 2) {
      double width = 150 + rand.nextDouble() * 100;   // wider for smoother curves
      double height = 40 + rand.nextDouble() * 80;    // varied height
      mountains.add(_Mountain(x, width, height, Colors.grey.shade800));
      x += width * 0.6; // overlap for natural look
    }
  }

  @override
  void update(double dt) {
    if (!isMoving) return;

    _updateLayer(farBuildings, dt);
    _updateLayer(midBuildings, dt);
    _updateLayer(nearBuildings, dt);
  }

  void _updateLayer(List<_Building> buildings, double dt) {
    for (final b in buildings) {
      b.x -= b.speed * 100 * dt;
    }

    // recycle buildings
    final first = buildings.first;
    final last = buildings.last;

    if (first.x + first.width < 0) {
      first.x = last.x + 160;
      buildings.removeAt(0);
      buildings.add(first);
    }
  }

  @override
  void render(Canvas canvas) {
    final size = game.size;
    final groundHeight = size.y * 0.25;
    final horizonY = size.y - groundHeight;

    _drawSky(canvas, size);
    _drawStars(canvas);
    _drawMoon(canvas);
    _drawMountains(canvas, horizonY);   // draw mountains before buildings
    _drawLayer(canvas, farBuildings, horizonY);
    _drawLayer(canvas, midBuildings, horizonY);
    _drawLayer(canvas, nearBuildings, horizonY);
    _drawFog(canvas, game.size);
  }

  void _drawLayer(Canvas canvas, List<_Building> buildings, double horizonY) {
    final paint = Paint();

    for (final b in buildings) {
      paint.color = b.color;

      // Rounded only at top corners
      final rrect = RRect.fromRectAndCorners(
        Rect.fromLTWH(b.x, horizonY - b.height, b.width, b.height),
        topLeft: const Radius.circular(8),
        topRight: const Radius.circular(8),
        bottomLeft: Radius.zero,
        bottomRight: Radius.zero,
      );

      canvas.drawRRect(rrect, paint);

      // building
      // canvas.drawRect(
      //   Rect.fromLTWH(b.x, horizonY - b.height, b.width, b.height),
      //   paint,
      // );

      // windows
      for (int i = 0; i < b.windows.length; i++) {
        final w = b.windows[i];

        final isLit = b.litWindows[i];

        final windowWidth = 6.0; // slightly bigger
        final windowHeight = 12.0; // constant height

        paint.color = isLit
            ? Colors.yellow.withOpacity(0.5 + Random().nextDouble() * 0.5)
            : Colors.black.withOpacity(0.2);

        canvas.drawRect(
          Rect.fromLTWH(
            b.x + w.dx,
            horizonY - b.height + w.dy,
            windowWidth,
            windowHeight,
          ),
          paint,
        );
      }
    }
  }

  void _drawSky(Canvas canvas, Vector2 size) {
    final rect = Rect.fromLTWH(0, 0, size.x, size.y);

    final gradient = LinearGradient(
      colors: [Colors.black, Colors.grey.shade900],
      begin: Alignment.topCenter,
      end: Alignment.bottomCenter,
    );

    final paint = Paint()..shader = gradient.createShader(rect);
    canvas.drawRect(rect, paint);
  }

  void _drawStars(Canvas canvas) {
    for (final s in stars) {
      final paint = Paint()
        ..color = Colors.white.withOpacity(s.glow);

      // glow effect
      canvas.drawCircle(s.pos, s.size * 2.5, paint..maskFilter = MaskFilter.blur(BlurStyle.normal, 3));

      // core star
      canvas.drawCircle(s.pos, s.size, Paint()..color = Colors.white.withOpacity(0.9));
    }
  }

  void _drawMoon(Canvas canvas) {
    final center = Offset(650, 100);

    final glowPaint = Paint()
      ..color = Colors.white.withOpacity(0.08)
      ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 40);

    // glow
    canvas.drawCircle(center, 60, glowPaint);

    // moon body
    canvas.drawCircle(
      center,
      22,
      Paint()..color = Colors.grey.shade200,
    );

    // slight shadow curve
    canvas.drawCircle(
      Offset(center.dx + 6, center.dy),
      22,
      Paint()..color = Colors.black.withOpacity(0.2),
    );
  }

  void _drawMountains(Canvas canvas, double horizonY) {
    final paint = Paint();

    for (final m in mountains) {
      paint.color = m.color;

      final path = Path();
      path.moveTo(m.x, horizonY);

      double midX = m.x + m.width / 2;
      double midY = horizonY - m.height;

      double endX = m.x + m.width;
      double endY = horizonY;

      // Bezier curve for smooth mountain
      path.quadraticBezierTo(midX, midY, endX, endY);

      // Slightly overlap for smoother silhouette
      path.lineTo(endX, horizonY);
      path.lineTo(m.x, horizonY);
      path.close();

      canvas.drawPath(path, paint);
    }
  }

  void _drawFog(Canvas canvas, Vector2 size) {
    final rect = Rect.fromLTWH(0, 0, size.x, size.y);

    final gradient = LinearGradient(
      begin: Alignment.bottomCenter,
      end: Alignment.topCenter,
      colors: [
        Colors.black.withOpacity(0.4), // dense near ground
        Colors.transparent,
      ],
    );

    final paint = Paint()..shader = gradient.createShader(rect);

    canvas.drawRect(rect, paint);
  }
}

