Barrel_prop


  @override
  void render(Canvas canvas, double groundY) {
    final rect = Rect.fromCenter(
      center: Offset(x, groundY - height / 2),
      width: width,
      height: height,
    );

    // MAIN BODY
    final bodyPaint = Paint()
      ..shader = LinearGradient(
        begin: Alignment.centerLeft,
        end: Alignment.centerRight,
        colors: [
          Colors.grey.shade900,
          Colors.grey.shade700,
          Colors.grey.shade900,
        ],
      ).createShader(rect);

    final body = RRect.fromRectAndRadius(
      rect,
      Radius.circular(width * 0.35),
    );

    canvas.drawRRect(body, bodyPaint);

    // WOOD PLANKS
    final plankPaint = Paint()
      ..color = Colors.grey.shade500.withOpacity(0.25)
      ..strokeWidth = 1;

    const plankCount = 7;

    for (int i = 1; i < plankCount; i++) {
      final px = rect.left + (rect.width / plankCount) * i;

      canvas.drawLine(
        Offset(px, rect.top + 2),
        Offset(px, rect.bottom - 2),
        plankPaint,
      );
    }

    // METAL BANDS
    final bandPaint = Paint()
      ..color = Colors.black.withOpacity(0.9)
      ..strokeWidth = 3;

    canvas.drawLine(
      Offset(rect.left + 2, rect.top + height * 0.25),
      Offset(rect.right - 2, rect.top + height * 0.25),
      bandPaint,
    );

    canvas.drawLine(
      Offset(rect.left + 2, rect.bottom - height * 0.25),
      Offset(rect.right - 2, rect.bottom - height * 0.25),
      bandPaint,
    );

    // EDGE SHADOW
    canvas.drawRRect(
      body,
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1
        ..color = Colors.black.withOpacity(0.5),
    );

    // HIGHLIGHT
    canvas.drawOval(
      Rect.fromLTWH(
        rect.left + width * 0.18,
        rect.top + 4,
        width * 0.12,
        height - 8,
      ),
      Paint()..color = Colors.white.withOpacity(0.05),
    );

    // GROUND SHADOW
    canvas.drawOval(
      Rect.fromCenter(
        center: Offset(x, groundY + 2),
        width: width * 1.2,
        height: 5,
      ),
      Paint()..color = Colors.black.withOpacity(0.45),
    );
  }


