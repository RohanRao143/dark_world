import 'dart:ui';
import 'dart:math';
import 'package:flame/components.dart';
import 'package:flutter/material.dart';
import 'my_game.dart';

class Player extends PositionComponent with HasGameReference<MyGame> {
  Player() {
    size = Vector2(40, 70);
  }

  bool isRunning = false;
  bool isJumping = false;
  bool isSliding = false;
  bool isBreaking = false;

  double animationTime = 0;
  double jumpTime = 0;
  double slideTimer = 0;
  double breakTimer = 0;

  double jumpDuration = 0.6;
  double slideDuration = 0.6;
  double breakDuration = 0.4;

  late double groundY;

  bool eyesOpen = true;
  double blinkTimer = 0;

  double slideOffset = 0;

  double slideVelocity = 0;

  @override
  Future<void> onLoad() async {
    final groundHeight = game.size.y * 0.25;
    position = Vector2(150, game.size.y - groundHeight - size.y);
  }

  void setGround(double y) {
    groundY = y;
    position.y = y;
  }

  void jump() {
    if (!isJumping && !isSliding) {
      isJumping = true;
      jumpTime = 0;
    }
  }

  void slide() {
    if (!isJumping && !isSliding) {
      isSliding = true;
      slideTimer = 0;
      // slideVelocity = 180; // 🔥 forward burst
    }
  }

  void collide() {
    if (!isBreaking) {
      isBreaking = true;
      breakTimer = 0;
    }
  }

  @override
  Rect toRect() {
    if (isSliding) {
      return Rect.fromLTWH(
        position.x,
        position.y + 40,
        size.x,
        size.y - 40,
      );
    }
    return super.toRect();
  }

  @override
  void update(double dt) {
    super.update(dt);

    if (isRunning) {
      animationTime += dt * 4;
    }

    // ----- JUMP -----
    if (isJumping) {
      jumpTime += dt;

      final t = (jumpTime / jumpDuration).clamp(0.0, 1.0);
      final dy = -4 * 90 * t * (1 - t);

      position.y = groundY + dy;

      if (t >= 1.0) {
        isJumping = false;
        position.y = groundY;
      }
    }

    // ----- SLIDE -----
    if (isSliding) {
      slideTimer += dt;
      if (slideTimer >= slideDuration) {
        isSliding = false;
      }
    }

    // smooth vertical offset for slide
    if (isSliding) {
      slideOffset = lerpDouble(slideOffset, 28, 0.25)!;
    } else {
      slideOffset = lerpDouble(slideOffset, 0, 0.2)!;
    }

    if (isSliding) {
      position.x += slideVelocity * dt;
      slideVelocity *= 0.92; // friction
    }

    if (!isJumping) {
      position.y = groundY;
    }

    // ----- BLINK -----
    blinkTimer += dt;
    if (blinkTimer > 3) {
      eyesOpen = false;
      if (blinkTimer > 3.2) {
        eyesOpen = true;
        blinkTimer = 0;
      }
    }

    // ----- BREAK -----
    if (isBreaking) {
      breakTimer += dt;
      if (breakTimer >= breakDuration) {
        isBreaking = false;
      }
    }
  }

  @override
  void render(Canvas canvas) {
    super.render(canvas);

    final centerX = size.x / 2;

    final bodyPaint = Paint()..color = Colors.black;

    // final front = Paint()
    //   ..color = Colors.black
    //   ..strokeWidth = 3.5
    //   ..strokeCap = StrokeCap.round;

    // final back = Paint()
    //   ..color = Colors.black.withOpacity(0.5)
    //   ..strokeWidth = 3.5
    //   ..strokeCap = StrokeCap.round;

    final limbPaint = Paint()
      ..color = Colors.black
      ..strokeWidth = 4
      ..strokeCap = StrokeCap.round;

    final handPaint = Paint()..color = Colors.black;

    final swing = isRunning && !isJumping && !isSliding
        ? sin(animationTime * 2) * 12
        : 0.0;

    final opposite = -swing;

    final jumpT = (jumpTime / jumpDuration).clamp(0.0, 1.0);
    final jumpCurve = sin(pi * jumpT);

    final headY = 14.0;
    final shoulderY = 26.0;
    final hipY = 52.0;
    final armY = shoulderY + 4;

    // 🔥 dynamic lean
    double lean = 0.02;
    if (isRunning) lean = 0.12;
    if (isJumping) lean = 0.2;
    if (isSliding) lean = -0.5;

    // =========================
    // 🧠 HEAD
    // =========================
    canvas.save();
    canvas.translate(centerX, headY);
    canvas.rotate(lean);

    canvas.drawOval(
      Rect.fromCenter(center: Offset.zero, width: 24, height: 24),
      bodyPaint,
    );

    if (eyesOpen) {
      canvas.drawCircle(Offset(4, -2), 2, Paint()..color = Colors.white);
    } else {
      canvas.drawLine(
        Offset(3, -2),
        Offset(6, -2),
        Paint()
          ..color = Colors.white
          ..strokeWidth = 1.5,
      );
    }

    final wave = sin(animationTime * 2) * 2;

    // final hair = Path()
    //   ..moveTo(-10, -8)
    //   ..quadraticBezierTo(-2, -16 + wave, 8, -8)
    //   ..lineTo(8, -3)
    //   ..quadraticBezierTo(-2, -10 + wave, -10, -3)
    //   ..close();


    final hair = Path();

    hair.moveTo(-11, -2);

    hair.quadraticBezierTo(
      -14,
      -16,
      -2,
      -18,
    );

    hair.quadraticBezierTo(
      10,
      -20 + wave,
      14,
      -6,
    );

    hair.quadraticBezierTo(
      8,
      -10,
      4,
      -2,
    );

    hair.lineTo(-11, -2);

    canvas.drawPath(hair, bodyPaint);
    canvas.restore();

    // =========================
    // 🧍 TORSO
    // =========================
    canvas.save();
    canvas.translate(centerX, 0);
    double bodyYOffset = 0;

// move head as well while sliding.

    if (isSliding) {
      bodyYOffset = 18; // how much body drops
    }

    double squash = 1.0;

    if (isSliding) {
      squash = 0.8;
    }

    canvas.scale(1.0, squash);

    canvas.translate(0, bodyYOffset);
    canvas.rotate(lean);

    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromCenter(
          center: Offset(0, (shoulderY + hipY) / 2),
          width: 16,
          height: hipY - shoulderY,
        ),
        Radius.circular(5),
      ),
      bodyPaint,
    );

    // =========================
    // 🦵 LEGS + 💪 ARMS (NEW SYSTEM)
    // =========================

    Offset backKnee, backFoot, frontKnee, frontFoot;
    Offset backElbow, backHand, frontElbow, frontHand;

    if (isJumping) {
      final legLift = jumpCurve * 18;
      final armLift = jumpCurve * 12;

      backKnee = Offset(-6, hipY + 16 - legLift);
      backFoot = Offset(-4, size.y - legLift);

      frontKnee = Offset(6, hipY + 16 - legLift);
      frontFoot = Offset(4, size.y - legLift);

      backElbow = Offset(-6, armY + 10 - armLift);
      backHand = Offset(-10, armY + 20 - armLift);

      frontElbow = Offset(6, armY + 10 - armLift);
      frontHand = Offset(10, armY + 20 - armLift);

    } else if (isSliding) {

      backKnee = Offset(-12, hipY + 8);
      backFoot = Offset(-20, size.y);

      frontKnee = Offset(12, hipY + 8);
      frontFoot = Offset(20, size.y);

      backElbow = Offset(-12, armY + 5);
      backHand = Offset(-18, armY + 10);

      frontElbow = Offset(0, armY + 5);
      frontHand = Offset(6, armY + 8);

    } else {
      // running
      backKnee = Offset(opposite * 0.6, hipY + 16);
      backFoot = Offset(opposite * 0.8, size.y);

      frontKnee = Offset(swing * 0.6, hipY + 16);
      frontFoot = Offset(swing * 0.8, size.y);

      backElbow = Offset(opposite * 0.6, armY + 10);
      backHand = Offset(opposite * 1.2, armY + 20);

      frontElbow = Offset(swing * 0.6, armY + 10);
      frontHand = Offset(swing * 1.2, armY + 20);
    }

    // DRAW LEGS
    canvas.drawLine(Offset(0, hipY), backKnee, limbPaint);
    canvas.drawLine(backKnee, backFoot, limbPaint);

    canvas.drawLine(Offset(0, hipY), frontKnee, limbPaint);
    canvas.drawLine(frontKnee, frontFoot, limbPaint);

    // DRAW ARMS
    canvas.drawLine(Offset(0, shoulderY), backElbow, limbPaint);
    canvas.drawLine(backElbow, backHand, limbPaint);
    canvas.drawCircle(backHand, 3, handPaint);

    canvas.drawLine(Offset(0, shoulderY), frontElbow, limbPaint);
    canvas.drawLine(frontElbow, frontHand, limbPaint);
    canvas.drawCircle(frontHand, 3, handPaint);

    canvas.restore();

    // =========================
    // 🌑 SHADOW
    // =========================
    final shadowScale = isJumping
        ? 1 - sin(pi * jumpT) * 0.5
        : 1.0;

    canvas.drawOval(
      Rect.fromCenter(
        center: Offset(centerX, size.y + 2),
        width: 20 * shadowScale,
        height: 6,
      ),
      Paint()..color = Colors.black,
    );

    // BREAK EFFECT
    if (isBreaking) {
      final glowPaint = Paint()
        ..color = Colors.white
        ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 10);

      canvas.drawCircle(
        Offset(size.x / 2, size.y / 2),
        30,
        glowPaint,
      );
    }
  }
}


