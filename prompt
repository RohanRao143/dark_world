import '../obstacles/obstacle.dart';

import 'player.dart';
import 'ground.dart';
import 'background.dart';
import 'fog.dart';

class MyGame extends FlameGame with TapCallbacks {
  late Player player;
  late Background background;
  late Ground ground;
  late Fog fog;
  late ObstacleManager obstacleManager;
  bool isGameOver = false;
  bool isHolding = false;

  @override
  Future<void> onLoad() async {
    final screenHeight = size.y;
    final groundHeight = screenHeight * 0.25;

    camera.viewfinder.visibleGameSize = Vector2(800, 400);

    background = Background();
    ground = Ground();
    fog = Fog();

    player = Player()
      ..position = Vector2(
        200,
        screenHeight - groundHeight - 60,
      );

    add(background);
    add(ground);
    add(player);
    add(fog);

    // AFTER add (important)
    player.setGround(
      screenHeight - groundHeight - 60,
    );


    obstacleManager = ObstacleManager();
    add(obstacleManager);
  }

  @override
  void update(double dt) {
    super.update(dt);
    if (isGameOver) return;
    
    background.isMoving = isHolding;
    ground.isMoving = isHolding;
    player.isRunning = isHolding;

    // 🔥 Collision check
    for (final component in children.whereType<Obstacle>()) {
      if (component.collidesWith(player)) {
        // component.onPlayerCollision(player);

          if (player.isBreaking) {
            component.removeFromParent(); // 🔥 destroy obstacle
          } else {
            component.onPlayerCollision(player);
            return;
          }

        return; // 🔥 stop loop immediately
      }
    }

  }


  void gameOver() {
    if (isGameOver) return; // prevent multiple calls

    isGameOver = true;
    isHolding = false;

    player.isRunning = false;

    // Optional: freeze world
    pauseEngine();
  }

  
  @override
  void onTapDown(TapDownEvent event) {
    isHolding = true;

    // final tapX = event.canvasPosition.x;

    // // 👉 Right side = jump
    // if (tapX > size.x / 2) {
    //   player.jump();
    // } else {
    //   player.slide(); // 👈 LEFT SIDE = SLIDE
    // }
  }

  @override
  void onTapUp(TapUpEvent event) {
    isHolding = false;
  }

  @override
  void onTapCancel(TapCancelEvent event) {
    isHolding = false;
  }
}

